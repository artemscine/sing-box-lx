+package group
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func fallbackFixture(t *testing.T) (*URLTestGroup, []*failoverNode) {
+	nodes := []*failoverNode{newFailoverNode("primary", 0), newFailoverNode("backup-one", 0), newFailoverNode("backup-two", 0)}
+	g := newFailoverTestGroup(t, nodes...)
+	g.failover = false
+	g.fallbackStart = 1
+	for index, node := range nodes {
+		g.history.StoreURLTestHistory(node.Tag(), &adapter.URLTestHistory{Time: time.Now(), Delay: uint16(300 - index*100)})
+	}
+	return g, nodes
+}
+
+func TestFallbackPriorityAndRecovery(t *testing.T) {
+	g, nodes := fallbackFixture(t)
+	g.performUpdateCheck()
+	assertSelected(t, g, N.NetworkTCP, nodes[0])
+	g.history.DeleteURLTestHistory(nodes[0].Tag())
+	g.performUpdateCheck()
+	assertSelected(t, g, N.NetworkTCP, nodes[1]) // second reserve is faster, but order wins
+	g.history.DeleteURLTestHistory(nodes[1].Tag())
+	g.performUpdateCheck()
+	assertSelected(t, g, N.NetworkTCP, nodes[2])
+	g.history.StoreURLTestHistory(nodes[0].Tag(), &adapter.URLTestHistory{Time: time.Now(), Delay: 900})
+	g.performUpdateCheck()
+	assertSelected(t, g, N.NetworkTCP, nodes[0]) // author behaviour: first successful probe
+}
+
+func TestFallbackReactiveRetryUsesReserveOrder(t *testing.T) {
+	g, nodes := fallbackFixture(t)
+	g.performUpdateCheck()
+	nodes[0].setErr(context.DeadlineExceeded)
+	g.history.DeleteURLTestHistory(nodes[0].Tag())
+	conn, selected, ok := g.penaltyFailoverDial(context.Background(), N.NetworkTCP, M.ParseSocksaddr(nodes[1].addr), nodes[0], context.DeadlineExceeded)
+	if !ok || selected != nodes[1] {
+		t.Fatal("reactive retry did not use first reserve")
+	}
+	conn.Close()
+	assertSelected(t, g, N.NetworkTCP, nodes[1])
+}
+
+func TestFallbackConfigValidation(t *testing.T) {
+	for _, options := range []option.URLTestOutboundOptions{
+		{Outbounds: []string{"a"}, Fallbacks: []string{"a"}},
+		{Outbounds: []string{"a"}, Fallbacks: []string{"b", "b"}},
+		{Fallbacks: []string{"b"}},
+		{Outbounds: []string{"a"}, Fallbacks: []string{"b"}, Mode: C.URLTestModeFailover},
+		{Outbounds: []string{"a"}, Fallbacks: []string{"b"}, Mode: C.URLTestModeRoundRobin},
+	} {
+		if _, err := NewURLTest(context.Background(), nil, logger.NOP(), "auto", options); err == nil {
+			t.Fatal("invalid reserve configuration accepted")
+		}
+	}
+	created, err := NewURLTest(context.Background(), nil, logger.NOP(), "auto", option.URLTestOutboundOptions{Outbounds: []string{"a"}, Fallbacks: []string{"b", "c"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	g := created.(*URLTest)
+	if len(g.All()) != 3 || len(g.Dependencies()) != 3 {
+		t.Fatal("reserves must be started and reported")
+	}
+}
+
+func TestFallbackProbesAllMembers(t *testing.T) {
+	g, nodes := fallbackFixture(t)
+	if _, err := g.urlTest(context.Background(), true); err != nil {
+		t.Fatal(err)
+	}
+	for _, node := range nodes {
+		assertDials(t, node, 1)
+	}
+}

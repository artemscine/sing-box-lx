diff --git a/protocol/group/urltest_fallback_lx.go b/protocol/group/urltest_fallback_lx.go
new file mode 100644
index 000000000..36be9c38a
--- /dev/null
+++ b/protocol/group/urltest_fallback_lx.go
@@ -0,0 +1,177 @@
+package group
+
+// lx: Podkop profile — ordered fallbacks, adapted from FiyeroT/podkop-engine
+// commit c89d4587dc22b6668e88061eb169ae4d98a1a153 (GPL-3.0-or-later).
+// Primary members compete by delay; only when none responds does the first
+// responding reserve win. A recovered primary takes precedence again.
+
+import (
+	"context"
+	"errors"
+	"net"
+	"os"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func fallbackTags(options option.URLTestOutboundOptions) ([]string, error) {
+	if len(options.Fallbacks) == 0 {
+		return options.Outbounds, nil
+	}
+	if len(options.Outbounds) == 0 {
+		return nil, E.New("urltest: missing primary outbounds")
+	}
+	if options.Mode != "" && options.Mode != C.URLTestModeLeastTest {
+		return nil, E.New("urltest: fallbacks require mode: least_test")
+	}
+	seen := make(map[string]bool)
+	tags := append([]string{}, options.Outbounds...)
+	for _, tag := range tags {
+		seen[tag] = true
+	}
+	for _, tag := range options.Fallbacks {
+		if seen[tag] {
+			return nil, E.New("urltest: fallback ", tag, " is already listed")
+		}
+		seen[tag] = true
+		tags = append(tags, tag)
+	}
+	return tags, nil
+}
+
+func (g *URLTestGroup) hasFallbacks() bool {
+	return g.fallbackStart > 0 && g.fallbackStart < len(g.outbounds)
+}
+
+func (g *URLTestGroup) fallbackCurrent(network string) adapter.Outbound {
+	g.access.Lock()
+	defer g.access.Unlock()
+	if network == N.NetworkTCP {
+		return g.selectedOutboundTCP
+	}
+	return g.selectedOutboundUDP
+}
+
+func (g *URLTestGroup) fallbackSelect(network, excluded string) (adapter.Outbound, bool) {
+	current := g.fallbackCurrent(network)
+	var best adapter.Outbound
+	var delay uint16
+	// A reserve does not seed the primary members' tolerance.
+	for _, member := range g.outbounds[:g.fallbackStart] {
+		tag := RealTag(g.outbound, member)
+		if tag == excluded || !supportsNetwork(member, network) {
+			continue
+		}
+		history := g.history.LoadURLTestHistory(tag)
+		if history == nil {
+			continue
+		}
+		if member == current {
+			best, delay = member, history.Delay
+			break
+		}
+	}
+	for _, member := range g.outbounds[:g.fallbackStart] {
+		tag := RealTag(g.outbound, member)
+		if tag == excluded || !supportsNetwork(member, network) {
+			continue
+		}
+		history := g.history.LoadURLTestHistory(tag)
+		if history != nil && (best == nil || int(delay) > int(history.Delay)+int(g.tolerance)) {
+			best, delay = member, history.Delay
+		}
+	}
+	if best != nil {
+		return best, true
+	}
+	for _, member := range g.outbounds[g.fallbackStart:] {
+		tag := RealTag(g.outbound, member)
+		if tag != excluded && supportsNetwork(member, network) && g.history.LoadURLTestHistory(tag) != nil {
+			return member, true
+		}
+	}
+	// Preserve the held choice when everything is down; cold start uses the
+	// first member, as in upstream. Neither is a confirmed retry candidate.
+	if current != nil && RealTag(g.outbound, current) != excluded {
+		return current, false
+	}
+	for _, member := range g.outbounds {
+		if RealTag(g.outbound, member) != excluded && supportsNetwork(member, network) {
+			return member, false
+		}
+	}
+	return nil, false
+}
+
+func (g *URLTestGroup) fallbackUpdate() {
+	g.updateAccess.Lock()
+	defer g.updateAccess.Unlock()
+	tcp, tcpAlive := g.fallbackSelect(N.NetworkTCP, "")
+	udp, udpAlive := g.fallbackSelect(N.NetworkUDP, "")
+	g.access.Lock()
+	changed, interrupt := false, false
+	if tcp != nil && (g.selectedOutboundTCP == nil || tcpAlive) && tcp != g.selectedOutboundTCP {
+		interrupt = g.selectedOutboundTCP != nil
+		g.selectedOutboundTCP = tcp
+		changed = true
+	}
+	if udp != nil && (g.selectedOutboundUDP == nil || udpAlive) && udp != g.selectedOutboundUDP {
+		interrupt = interrupt || g.selectedOutboundUDP != nil
+		g.selectedOutboundUDP = udp
+		changed = true
+	}
+	g.access.Unlock()
+	if interrupt {
+		g.interruptGroup.Interrupt(g.interruptExternalConnections)
+	}
+	if changed {
+		invalidateReachability(g.ctx)
+		g.history.NotifyUpdated()
+	}
+}
+
+func (g *URLTestGroup) fallbackNow() string {
+	if selected := g.fallbackCurrent(N.NetworkTCP); selected != nil {
+		return selected.Tag()
+	}
+	if selected := g.fallbackCurrent(N.NetworkUDP); selected != nil {
+		return selected.Tag()
+	}
+	selected, _ := g.fallbackSelect(N.NetworkTCP, "")
+	if selected != nil {
+		return selected.Tag()
+	}
+	return ""
+}
+
+func (g *URLTestGroup) fallbackReferences() []string {
+	g.access.Lock()
+	defer g.access.Unlock()
+	var tags []string
+	if g.selectedOutboundTCP != nil {
+		tags = append(tags, g.selectedOutboundTCP.Tag())
+	}
+	if g.selectedOutboundUDP != nil && g.selectedOutboundUDP != g.selectedOutboundTCP {
+		tags = append(tags, g.selectedOutboundUDP.Tag())
+	}
+	return tags
+}
+
+// A server-only protocol's failed TCP dial is evidence about the proxy path,
+// including an actively refused connection. Destination-dialing protocols keep
+// lx's existing timeout/unreachable classifier. Caller cancellation is ignored.
+func fallbackServerFailure(member adapter.Outbound, err error) bool {
+	if errors.Is(err, context.Canceled) || errors.Is(err, net.ErrClosed) || errors.Is(err, os.ErrClosed) {
+		return false
+	}
+	switch member.Type() {
+	case C.TypeVLESS, C.TypeVMess, C.TypeTrojan, C.TypeShadowsocks, C.TypeShadowTLS,
+		C.TypeHysteria, C.TypeHysteria2, C.TypeTUIC, C.TypeAnyTLS, C.TypeNaive:
+		return true
+	}
+	return false
+}
